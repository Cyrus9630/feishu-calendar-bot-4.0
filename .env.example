# 飞书应用凭据。仅填写到你自己的妙搭环境变量，不要提交真实值。
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=replace_with_your_app_secret
FEISHU_VERIFICATION_TOKEN=replace_with_your_verification_token
FEISHU_ENCRYPT_KEY=replace_with_your_encrypt_key_or_leave_empty

# 机器人服务范围。
CHAT_ID=oc_your_target_chat_id
TARGET_OPEN_ID=ou_your_calendar_owner_open_id
TARGET_CALENDAR_ID=your_shared_calendar_id
BOT_OPEN_ID=ou_your_bot_open_id
BOT_NAME=日程机器人

# 固定使用中国标准时间。
TZ=Asia/Shanghai
